{
  "name": "qr-menu",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/icons.svg", "!/firebase-messaging-sw.js"]
  }
}
